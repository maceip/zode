<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The vibrator is used for the haptic programs (contract §7). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Local notifications for finished agent tasks (contract §9). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.vibrator"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zode">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Zode"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The `zode://` deep link scheme (contract §4). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zode" android:host="view" />
                <data android:scheme="zode" android:host="search" />
                <data android:scheme="zode" android:host="play" />
                <data android:scheme="zode" android:host="agent" />
                <data android:scheme="zode" android:host="attach" />
                <data android:scheme="zode" android:host="collection" />
                <data android:scheme="zode" android:host="library" />
                <data android:scheme="zode" android:host="now-playing" />
            </intent-filter>

            <!-- System search (contract §10). -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />

            <!-- The share sheet hands files to the app (contract §8). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- The search suggestion provider (contract §10). -->
        <provider
            android:name=".intents.ZodeSearchProvider"
            android:authorities="com.zode.app.search"
            android:exported="false" />
    </application>
</manifest>

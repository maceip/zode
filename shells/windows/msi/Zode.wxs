<?xml version="1.0" encoding="utf-8"?>
<!--
  Zode — Windows Installer package (WiX v5).

  The payload is the published shell: Zode.Shell.exe, the bundled web app in
  web/, and zode.ico.  The web app has to sit NEXT TO the executable — the
  shell maps it into the webview with SetVirtualHostNameToFolderMapping and
  reads it from AppContext.BaseDirectory\web — so it cannot be embedded in
  the executable.  That is why this is an installer and not a single file.

  WiX v5 harvests a whole directory with the <Files> element, so there is no
  heat.exe and no XSLT here.

  Build it with the wix tool (install it globally with the dotnet CLI, then):

      wix build shells\windows\msi\Zode.wxs ^
          -d ZodeAppDir=C:\...\publish\win-x64 ^
          -d ZodeIcon=C:\...\icons\zode.ico ^
          -d ZodeVersion=1.0.0 ^
          -o Zode.msi

  or just run shells\windows\build-msi.ps1, which does all of that.

  The scope is perUser: the installer needs no administrator rights and the
  app lands in the user's own AppData, like the unpackaged build.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Zode"
           Manufacturer="Zode"
           Version="$(ZodeVersion)"
           UpgradeCode="55CDAA7A-F896-5A95-AB5D-7E71FB3F78BD"
           Language="1033"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Zode is already installed. Uninstall it first." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ZodeIcon" SourceFile="$(ZodeIcon)" />

    <Property Id="ARPPRODUCTICON" Value="ZodeIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCONTACT" Value="Zode" />

    <!-- The application itself. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Zode" />
    </StandardDirectory>

    <!-- The Start menu entry. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Zode">
        <Component Id="ShortcutComponent" Guid="BD601ECE-2F03-5AC1-8218-DAA7DC1C8723">
          <Shortcut Id="ZodeShortcut"
                    Name="Zode"
                    Description="Zode — code content before chrome"
                    Target="[INSTALLFOLDER]Zode.Shell.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="ZodeIcon"
                    Register="yes" />
          <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\Zode"
                         Name="Installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Zode" Level="1" AllowAbsent="no">
      <!-- Everything in the publish directory, subdirectories included. -->
      <Files Include="$(ZodeAppDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="ShortcutComponent" />
    </Feature>

  </Package>
</Wix>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shell is distributed outside the App Store (Developer ID), so
	     the App Sandbox is off: the app needs to read the files the user
	     drops on the window or on the Dock icon, no matter where they live. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Dev mode (contract §1.3) talks to a local dev server. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The native file picker (contract §8) hands the chosen files to the
	     app. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
